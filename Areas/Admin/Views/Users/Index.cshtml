@model List<User>
@{
    ViewData["Title"] = "Manage User";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Users</h2>

<a asp-action="AddUpdate" class="btn btn-primary mb-3">Add User</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>SSN</th>
            <th>User Type</th>
            <th width="180">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Name</td>
                <td>@u.PhoneNumber</td>
                <td>@u.Email</td>
                <td>@u.SSN</td>
                <td>@u.UserType</td>
                <td>
                    <a asp-action="AddUpdate" asp-route-id="@u.UserId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@u.UserId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
