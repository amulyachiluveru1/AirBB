@using AirBB.Models
@model IEnumerable<Residence>

@{
    ViewData["Title"] = "Manage Residences";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Manage Residences</h2>
        <a asp-action="AddUpdate" asp-controller="Residences" asp-area="Admin" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Residence
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">No residences found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Owner</th>
                                <th>Location</th>
                                <th>Accommodation</th>
                                <th>Bedrooms</th>
                                <th>Bathrooms</th>
                                <th>Built Year</th>
                                <th>Price (Night)</th>
                                <th style="width:150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageFileName))
                                        {
                                            <img src="~/images/@item.ImageFileName" alt="@item.Name"
                                                 class="img-thumbnail" style="width:70px;height:70px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Image</span>
                                        }
                                    </td>

                                    <td>@item.Name</td>
                                    <td>@item.Owner?.Name</td>
                                    <td>@item.Location?.Name</td>
                                    <td>@item.Accommodation</td>
                                    <td>@item.Bedrooms</td>
                                    <td>@item.Bathrooms</td>
                                    <td>@item.BuiltYear</td>
                                    <td>@item.PricePerNight.ToString("C")</td>

                                    <td>
                                        <div class="btn-group" role="group">

                                            <a asp-action="AddUpdate"
                                               asp-route-id="@item.ResidenceId"
                                               class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>

                                            <form asp-action="Delete" asp-route-id="@item.ResidenceId"
                                                  method="post" onsubmit="return confirm('Are you sure?');">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
