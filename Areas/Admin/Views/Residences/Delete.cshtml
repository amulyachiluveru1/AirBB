@model Residence

@{
    ViewData["Title"] = "Delete Residence";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Residence</h4>
        </div>

        <div class="card-body">

            <p class="text-danger fw-bold">
                Are you sure you want to delete this residence?
            </p>

            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.Location?.Name</dd>

                <dt class="col-sm-3">Accommodation</dt>
                <dd class="col-sm-9">@Model.Accommodation</dd>

                <dt class="col-sm-3">Bedrooms</dt>
                <dd class="col-sm-9">@Model.Bedrooms</dd>

                <dt class="col-sm-3">Bathrooms</dt>
                <dd class="col-sm-9">@Model.Bathrooms</dd>

                <dt class="col-sm-3">Built Year</dt>
                <dd class="col-sm-9">@Model.BuiltYear</dd>

                <dt class="col-sm-3">Price Per Night</dt>
                <dd class="col-sm-9">@Model.PricePerNight.ToString("C")</dd>

                <dt class="col-sm-3">Image</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.ImageFileName))
                    {
                        <img src="~/images/@Model.ImageFileName"
                             class="img-thumbnail"
                             style="width:150px;height:150px;object-fit:cover;" />
                    }
                    else
                    {
                        <span class="text-muted">No Image</span>
                    }
                </dd>
            </dl>

            <div class="mt-4 d-flex justify-content-between">

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Cancel
                </a>

                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" asp-for="ResidenceId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirm Delete
                    </button>
                </form>

            </div>

        </div>
    </div>
</div>
