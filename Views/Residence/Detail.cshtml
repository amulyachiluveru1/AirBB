@model AirBB.Models.AirBnbViewModel
@{
    ViewData["Title"] = "Home - AirBB";
    Layout = "_MainLayout";
    var res = Model.SelectedResidence!;
}
<div class="row mt-3">
    <div class="col-md-6">
        <img src="~/images/@res.ResidencePicture" class="img-fluid" alt="@res.Name" />
    </div>
    <div class="col-md-6">
        <h2 class="text-info fw-bold">@res.Name</h2>
        <p><strong>Location:</strong> @res.Location?.Name</p>
        <p><strong>Guests:</strong> @res.GuestNumber</p>
        <p><strong>Bedrooms:</strong> @res.BedroomNumber</p>
        <p><strong>Bathrooms:</strong> @res.BathroomNumber</p>
        <p><strong>Price:</strong> @res.PricePerNight.ToString("C") / night</p>

        <form asp-controller="Residence" asp-action="Reserve" method="post" class="mt-3">
            <input type="hidden" name="residenceId" value="@res.ResidenceId" />
            <div class="mb-2">
                <label>Start</label>
                <input name="start" type="date" class="form-control" required />
            </div>
            <div class="mb-2">
                <label>End</label>
                <input name="end" type="date" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-success">Reserve</button>
            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary ms-2">Back to Home</a>
        </form>
    </div>
</div>
