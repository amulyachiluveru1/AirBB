@using AirBB.Models.ViewModels
@model AirBnbViewModel
@{
    ViewData["Title"] = "Home - AirBB";
    Layout = "_MainLayout";
}
<h3 class="mt-3">My Reservations</h3>

@if (Model.Reservations == null || !Model.Reservations.Any())
{
    <p>No reservations yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Residence</th>
                <th>Location</th>
                <th>Start</th>
                <th>End</th>
                <th>Price / night</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Reservations)
            {
                <tr>
                    <td>@r.Residence?.Name</td>
                    <td>@r.Residence?.Location?.Name</td>
                    <td>@r.ReservationStartDate.ToString("MM/dd/yyyy")</td>
                    <td>@r.ReservationEndDate.ToString("MM/dd/yyyy")</td>
                    <td>@r.Residence?.PricePerNight.ToString("C")</td>
                    <td>
                        <form method="post" asp-action="Cancel" asp-controller="Reservation">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reservationId" value="@r.ReservationId" />
                            <button class="btn btn-sm btn-danger" type="submit">Cancel</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
